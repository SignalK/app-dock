{
  "name": "@signalk/app-dock",
  "version": "1.4.0",
  "description": "macOS-style configurable app dock for switching between SignalK webapps on touch screens",
  "repository": {
    "url": "https://github.com/SignalK/app-dock"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-plugin-configurator",
    "signalk-category-instruments"
  ],
  "signalk-plugin-enabled-by-default": true,
  "signalk": {
    "displayName": "App Dock",
    "appIcon": "./app-icon.svg",
    "screenshots": [
      "./docs/screenshots/1_app-dock_preview.png",
      "./docs/screenshots/2_app-dock_entry.png",
      "./docs/screenshots/3_app-dock_config.png"
    ]
  },
  "type": "module",
  "main": "dist/plugin/index.js",
  "files": [
    "dist/plugin/",
    "public/",
    "docs/screenshots/"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:config",
    "build:server": "tsc",
    "build:config": "vite build --config vite.configpanel.config.ts",
    "prepublishOnly": "npm run build",
    "format": "prettier --write . && eslint --fix .",
    "lint": "eslint .",
    "format:check": "prettier --check . && eslint .",
    "test": "node --test \"dist/test/**/*.test.js\""
  },
  "author": "Dirk Wahrheit <dirkwahrheit@gmail.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "typebox": "^1.3.37"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@module-federation/vite": "^1.23.5",
    "@signalk/server-api": "^2.33.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-checker": "^0.14.5"
  }
}
